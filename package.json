{
  "name": "donna-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Donna — voice-first capture → dynamic organization → retrieval. MVP core loop.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval": "npm run eval --workspace @donna/evals",
    "capture": "npm run start --workspace @donna/cli --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
