# TrueFoundry AI Gateway (company catalog) — OpenAI-compatible endpoint.
# INTERNAL DEMO USE ONLY. Public product must use separate vendor accounts.
TRUEFOUNDRY_BASE_URL=https://your-gateway.truefoundry.cloud/api/llm
