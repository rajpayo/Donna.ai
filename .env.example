# TrueFoundry AI Gateway (company catalog) — OpenAI-compatible endpoint.
# INTERNAL DEMO USE ONLY. Public product must use separate vendor accounts.
TRUEFOUNDRY_BASE_URL=https://your-gateway.truefoundry.cloud/api/llm
TRUEFOUNDRY_API_KEY=replace-me

# Optional: tag every request for gateway cost tracking (user/stage/model breakdowns).
DONNA_TENANT_ID=demo-tenant
DONNA_APP_ID=donna-mvp

# Audio encryption key (Spec 1.3) — base64- or hex-encoded 32 bytes, from
# runtime secret management. Never committed; never stored beside ciphertext.
# Generate locally with: openssl rand -base64 32
DONNA_AUDIO_KEY=replace-me

# Where the file-backed bucket store and captures live (gitignored).
DONNA_DATA_DIR=./data

# Model selection lives in models.config.yaml — point elsewhere to A/B a stack.
DONNA_MODELS_CONFIG=./models.config.yaml
